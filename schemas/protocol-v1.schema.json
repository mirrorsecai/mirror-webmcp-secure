{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mirrorsecai/mirror-webmcp-secure/blob/main/schemas/protocol-v1.schema.json",
  "title": "Mirror WebMCP protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/siteManifest" },
    { "$ref": "#/$defs/session" },
    { "$ref": "#/$defs/toolCall" },
    { "$ref": "#/$defs/toolResult" },
    { "$ref": "#/$defs/approvalRequest" },
    { "$ref": "#/$defs/approval" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "safeToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "endpoint", "inputSchema"],
      "properties": {
        "name": { "$ref": "#/$defs/safeToken" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "endpoint": { "type": "string", "minLength": 1 },
        "inputSchema": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } }
        },
        "annotations": { "type": "object" },
        "requiresApproval": { "type": "boolean" },
        "approvalSummary": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "siteManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "siteId", "allowedOrigins", "contextEndpoint", "packs"],
      "properties": {
        "schema": { "const": "mirror.webmcp.site_manifest.v1" },
        "siteId": { "$ref": "#/$defs/safeToken" },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "contextEndpoint": { "type": "string", "minLength": 1 },
        "approvalEndpoint": { "type": "string", "minLength": 1 },
        "packs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "tools"],
            "properties": {
              "name": { "$ref": "#/$defs/safeToken" },
              "tools": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/tool" }
              }
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sessionId"],
      "properties": {
        "schema": { "const": "mirror.webmcp.session.v1" },
        "siteId": { "$ref": "#/$defs/safeToken" },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "siteId", "tool", "arguments"],
      "properties": {
        "schema": { "const": "mirror.webmcp.tool_call.v1" },
        "siteId": { "$ref": "#/$defs/safeToken" },
        "tool": { "$ref": "#/$defs/safeToken" },
        "arguments": { "type": "object" },
        "approvalToken": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "value"],
      "properties": {
        "schema": { "const": "mirror.webmcp.tool_result.v1" },
        "value": true
      }
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "siteId", "tool", "arguments"],
      "properties": {
        "schema": { "const": "mirror.webmcp.approval_request.v1" },
        "siteId": { "$ref": "#/$defs/safeToken" },
        "tool": { "$ref": "#/$defs/safeToken" },
        "arguments": { "type": "object" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "approvalToken", "expiresAt"],
      "properties": {
        "schema": { "const": "mirror.webmcp.approval.v1" },
        "approvalToken": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "error"],
      "properties": {
        "schema": { "const": "mirror.webmcp.error.v1" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "stage"],
          "properties": {
            "code": { "$ref": "#/$defs/safeToken" },
            "stage": { "$ref": "#/$defs/safeToken" },
            "requestId": { "$ref": "#/$defs/safeToken" },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
