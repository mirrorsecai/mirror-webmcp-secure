# Vercel supplies VERCEL_OIDC_TOKEN automatically in production.
# For local development, use `vercel env pull` or set an AI Gateway key.
AI_GATEWAY_API_KEY=
SELLER_AGENT_MODEL=poolside/laguna-s-2.1-free

# Required in production. Development uses a clearly scoped local-only key.
PROPOSAL_SIGNING_KEY=

# Required in production. Encrypts and authenticates endpoint-backed WebMCP handles.
MIRROR_WEBMCP_HANDLE_KEY=

# Optional server-to-server Mirror encrypted-inference seller route.
MIRROR_WEBMCP_FHE_URL=
MIRROR_WEBMCP_FHE_TOKEN=
